# ============================================================
#  UAPE Frontend — переменные окружения
#  Скопируйте этот файл: cp .env.example .env
# ============================================================

# URL бэкенда. При локальной разработке оставьте /api — Vite проксирует запросы.
VITE_API_URL=/api

# Google OAuth Client ID — тот же, что GOOGLE_CLIENT_ID в back_end/.env
# Нужен для кнопки "Войти через Google"
VITE_GOOGLE_CLIENT_ID=

# Опционально: если бэкенд запущен на другом порту (не 8000)
# VITE_API_TARGET=http://localhost:8001
