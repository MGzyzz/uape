# ============================================================
#  UAPE Backend — переменные окружения
#  Скопируйте этот файл: cp .env.example .env
#  Заполните все значения перед запуском сервера
# ============================================================

# ------ Django ------

# Секретный ключ — обязательно замените на случайную строку!
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=замените-на-случайную-строку

# True для разработки, False для продакшна
DEBUG=True

# ------ YouTube API ------
# Получить: console.cloud.google.com → APIs & Services → YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=

# ------ Google OAuth (вход через Google) ------
# Получить: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Тот же Client ID нужно вставить в front_end/.env как VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# ------ Email (подтверждение регистрации) ------
# Используйте Gmail-адрес и пароль приложения (не обычный пароль!)
# Как получить пароль приложения: Google-аккаунт → Безопасность → Пароли приложений
EMAIL_HOST_USER=example@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=example@gmail.com

# Адрес фронтенда — вставляется в ссылку в письме
FRONTEND_URL=http://localhost:5173

# ------ База данных (только для продакшна) ------
# Локально используется SQLite, заполнять не нужно
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ------ Продакшн / деплой ------
# Заполнять только при деплое на сервер

# Дополнительные разрешённые хосты (домен сервера, без https://)
# ALLOWED_EXTRA_HOSTS=yourdomain.com

# Дополнительные разрешённые источники CORS (URL фронтенда на сервере)
# CORS_EXTRA_ORIGINS=https://yourdomain.com

# Дополнительные разрешённые CSRF-источники
# CSRF_EXTRA_ORIGINS=https://yourdomain.com
